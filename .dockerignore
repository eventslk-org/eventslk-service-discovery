# Build output — the builder stage compiles from source
target/

# Version control — never ship .git history into the build context
.git/
.gitignore

# CI / container / IaC metadata not needed for the image build
.github/
k8s/
docker-compose.yml
Dockerfile
.dockerignore

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store

# Local env / secrets — never bake into the image
.env
*.env

# Logs and docs
*.log
README.md
HELP.md
